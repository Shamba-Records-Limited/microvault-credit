{
  "name": "spike_multi",
  "stream_type": "logs",
  "stream_name": "default",
  "is_real_time": false,
  "query_condition": {
    "type": "custom",
    "conditions": {
      "and": [
        {
          "column": "msg",
          "operator": "=",
          "value": "ops alert",
          "ignore_case": false
        },
        {
          "column": "level",
          "operator": "=",
          "value": "ERROR",
          "ignore_case": false
        },
        {
          "column": "alert_message",
          "operator": "contains",
          "value": "multi",
          "ignore_case": false
        }
      ]
    },
    "sql": null,
    "promql": null,
    "promql_condition": null,
    "aggregation": {
      "group_by": [
        "alert_subject"
      ],
      "function": "count",
      "having": {
        "column": "alert_subject",
        "operator": ">=",
        "value": 1,
        "ignore_case": false
      },
      "multi_alert": true
    },
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": null
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 30,
    "tolerance_in_secs": null,
    "align_time": true
  },
  "destinations": [
    "spike_echo"
  ],
  "context_attributes": {
    "tier": "page"
  },
  "row_template": "{alert_subject}",
  "row_template_type": "String",
  "description": "per-group probe",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false,
  "workflows": [],
  "pending_period_sec": 0
}
