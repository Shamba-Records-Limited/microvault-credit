package views

// NavItem is a single sidebar entry. Icon is a Phosphor icon name.
type NavItem struct {
	Label string
	Href  string
	Icon  string
}

// Nav is the sidebar in render order.
var Nav = []NavItem{
	{Label: "Dashboard", Href: "/", Icon: "gauge"},
	{Label: "Loans", Href: "/loans", Icon: "bank"},
	{Label: "Transactions", Href: "/transactions", Icon: "arrows-left-right"},
	{Label: "Users", Href: "/users", Icon: "users"},
	{Label: "Loan products", Href: "/loan-products", Icon: "package"},
	{Label: "Limits", Href: "/limits", Icon: "sliders-horizontal"},
	{Label: "Config", Href: "/config", Icon: "gear"},
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="robots" content="noindex, nofollow"/>
		<title>{ title } · Microvault portal</title>
		<link rel="icon" type="image/x-icon" href="/static/favicon.ico"/>
		<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"/>
		<link rel="stylesheet" href="/static/admin.css"/>
		<script src="/static/htmx.min.js" defer></script>
		<script src="/static/sidebar.js" defer></script>
	</head>
}

// Shell is the authenticated layout: sidebar plus main content region.
//
// Sidebar and content are separate floating cards (gap between them shows
// the background), but the navbar and content area share a single card —
// only a border-b divides them, not a gap — so they read as one surface.
templ Shell(title, current string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		@head(title)
		<body class="h-full bg-background text-foreground">
			<div class="flex h-full w-full overflow-hidden">
				<aside
					id="sidebar"
					data-collapsed="false"
					class="group w-60 shrink-0 p-2 transition-[width] duration-200 data-[collapsed=true]:w-16"
				>
					<div class="flex h-full w-full flex-col rounded-lg border border-sidebar-border bg-sidebar shadow-sm">
						<div class="flex h-14 items-center justify-between px-5 group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:px-0">
							<a href="/" class="flex items-center gap-2 text-foreground" aria-label="Microvault portal home">
								@Logo("size-6 shrink-0")
								<span class="text-sm font-semibold tracking-tight group-data-[collapsed=true]:hidden">
									Microvault
								</span>
							</a>
							<button
								id="sidebar-toggle"
								type="button"
								aria-expanded="true"
								aria-label="Collapse sidebar"
								class="rounded-md p-1.5 text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
							>
								<i class="ph ph-sidebar-simple text-base" aria-hidden="true"></i>
							</button>
						</div>
						<nav class="flex flex-col gap-0.5 px-3 py-2 group-data-[collapsed=true]:px-2">
							for _, item := range Nav {
								@navLink(item, current)
							}
						</nav>
					</div>
				</aside>
				<div class="flex min-h-0 min-w-0 flex-1 flex-col gap-2 p-2 pl-0">
					<div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg border border-border bg-card text-card-foreground shadow-sm">
						<header class="flex h-14 shrink-0 items-center justify-between border-b border-border px-6">
							<h1 class="text-sm font-medium">{ title }</h1>
							<form method="post" action="/logout">
								<button type="submit" class="text-xs text-muted-foreground hover:text-foreground">
									Sign out
								</button>
							</form>
						</header>
						<main class="min-w-0 flex-1 overflow-y-auto p-6">
							{ children... }
						</main>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ navLink(item NavItem, current string) {
	if item.Href == current {
		<a
			href={ templ.SafeURL(item.Href) }
			aria-current="page"
			title={ item.Label }
			class="flex items-center gap-2.5 rounded-md bg-sidebar-accent px-3 py-2 text-sm font-medium text-sidebar-accent-foreground group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:px-2"
		>
			<i class={ "ph ph-" + item.Icon + " text-base shrink-0" } aria-hidden="true"></i>
			<span class="truncate group-data-[collapsed=true]:hidden">{ item.Label }</span>
		</a>
	} else {
		<a
			href={ templ.SafeURL(item.Href) }
			title={ item.Label }
			class="flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:px-2"
		>
			<i class={ "ph ph-" + item.Icon + " text-base shrink-0" } aria-hidden="true"></i>
			<span class="truncate group-data-[collapsed=true]:hidden">{ item.Label }</span>
		</a>
	}
}

// Bare is the unauthenticated layout, used by the sign-in page.
templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		@head(title)
		<body class="grid h-full place-items-center bg-background text-foreground">
			{ children... }
		</body>
	</html>
}
